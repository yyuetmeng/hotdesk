{
  "name": "hotdesk",
  "version": "0.1.0",
  "description": "Hot desk seat occupancy monitoring with live admin dashboard",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/index.js",
    "simulate": "node scripts/simulate.js",
    "simulate:fresh": "node scripts/simulate.js --reset",
    "demo": "node scripts/demo.js",
    "test": "node --test",
    "labels": "node scripts/labels.js",
    "codespace": "bash scripts/codespace.sh start",
    "codespace:stop": "bash scripts/codespace.sh stop",
    "codespace:status": "bash scripts/codespace.sh status"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
