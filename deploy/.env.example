# Copy to .env on the server and fill in. Never commit the real .env.

# Host name people will use (DNS must point at this server)
DOMAIN=hotdesk.example.com

# Long random secrets, e.g. from:  openssl rand -hex 24
ADMIN_TOKEN=change-me
SENSOR_API_KEY=change-me

# Optional
TZ=Asia/Singapore
AWAY_GRACE_MINUTES=20
CHECKIN_DURATION_MINUTES=180
# HOTDESK_IMAGE=ghcr.io/yyuetmeng/hotdesk:latest
