# Caddy serves the app over HTTPS and gets/renews the certificate for $DOMAIN
# automatically (the server must be reachable on ports 80 and 443).
#
# Internal-only host that the internet can't reach? Add this line inside the block:
#     tls internal                                  (Caddy's own certificate authority), or
#     tls /certs/cert.pem /certs/key.pem            (your company certificate; mount /certs)
{$DOMAIN} {
	encode gzip
	reverse_proxy hotdesk:3000
}
