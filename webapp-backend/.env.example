SUPABASE_CONNECTION_STRING=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Required. Make one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES=43200
# "Keep me signed in on this device" token lifetime in seconds (5 days)
JWT_REMEMBER_EXPIRES=432000
RESEND_API_KEY=
EMAIL_FROM=
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
LOG_FILE=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_FULL_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=
# Local PostgreSQL for the test suite only (must be localhost; never Supabase)
TEST_DATABASE_URI=postgresql://postgres:<password>@localhost:5432/postgres
